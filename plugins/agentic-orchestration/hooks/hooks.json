{
	"description": "Refresh community intelligence cache for agentic orchestration knowledge at session start",
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|clear",
				"hooks": [
					{
						"type": "command",
						"command": "bunx @side-quest/community-intel-cache refresh --config \"${CLAUDE_PLUGIN_ROOT}/community-intel.json\" --cache-dir \"${CLAUDE_PLUGIN_ROOT}/skills/agentic-orchestration/cache\"",
						"timeout": 180,
						"async": true
					}
				]
			}
		]
	}
}
