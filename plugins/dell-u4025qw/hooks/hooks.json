{
	"description": "Refresh community intelligence cache at session start (workaround for anthropics/claude-code#17688 - plugin skill frontmatter hooks are broken)",
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|clear",
				"hooks": [
					{
						"type": "command",
						"command": "bunx @side-quest/community-intel-cache refresh --config \"${CLAUDE_PLUGIN_ROOT}/community-intel.json\" --cache-dir \"${CLAUDE_PLUGIN_ROOT}/skills/dell-u4025qw/cache\"",
						"timeout": 180,
						"async": true
					}
				]
			}
		]
	}
}
